{
  "name": "bunny-ui-next",
  "version": "0.0.3",
  "author": "zhaoyifan",
  "homepage": "https://zhao-yi-fan.github.io/bunny-ui-next/",
  "private": false,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "test:unit": "vue-cli-service test:unit",
    "lib": "vue-cli-service build --target lib --name bunnyUi ./src/packages/index.ts --no-clean && vue-cli-service build --all --no-clean",
    "docs:serve": "vitepress dev docs --host 0.0.0.0 --port 8081",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 0.0.0.0 --port 8081"
  },
  "main": "./dist/bunnyUi.umd.min.js",
  "files": [
    "dist/bunnyUi.common.js",
    "dist/bunnyUi.css",
    "dist/bunnyUi.umd.js",
    "dist/bunnyUi.umd.min.js",
    "dist/lib",
    "dist/css/button",
    "dist/css/button-group",
    "dist/css/dialog",
    "dist/css/divider",
    "dist/css/icon",
    "dist/css/input",
    "dist/css/message",
    "dist/css/tag",
    "dist/css/watermark",
    "README.md"
  ],
  "dependencies": {
    "core-js": "3.45.1",
    "eslint-config-standard": "17.1.0",
    "vue": "3.5.34",
    "vue-router": "5.0.6"
  },
  "devDependencies": {
    "@types/chai": "5.2.2",
    "@types/mocha": "10.0.10",
    "@typescript-eslint/eslint-plugin": "8.42.0",
    "@typescript-eslint/parser": "8.42.0",
    "@vue/cli-plugin-babel": "5.0.9",
    "@vue/cli-plugin-typescript": "5.0.9",
    "@vue/cli-plugin-unit-mocha": "5.0.8",
    "@vue/cli-service": "5.0.9",
    "@vue/compiler-sfc": "3.5.34",
    "@vue/test-utils": "2.4.6",
    "chai": "6.0.1",
    "eslint": "9.35.0",
    "eslint-plugin-vue": "10.4.0",
    "prettier": "3.6.2",
    "sass": "1.92.0",
    "sass-loader": "16.0.5",
    "stream-browserify": "^3.0.0",
    "typescript": "5.8.3",
    "vitepress": "1.6.4"
  }
}
